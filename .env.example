# Copy to .env.local and fill in. Never commit .env.local.
# Variables prefixed NEXT_PUBLIC_ are shipped to the browser.

# --- Supabase (required) ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key. Server-only, bypasses RLS. Used by src/lib/supabase/admin.ts and the tests.
SUPABASE_SERVICE_ROLE_KEY=

# --- Analytics / monitoring (optional) ------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_HOTJAR_SCRIPT_URL=

# --- Internal job auth -----------------------------------------------------
# Bearer secret for POST /api/leaderboard/generate-snapshots
CRON_SECRET_KEY=
# Header secret for the AI review worker, POST /api/ai-review/run
AI_REVIEW_WORKER_SECRET=

# --- AI task reviewer (My Journey) -----------------------------------------
OPENAI_API_KEY=

# --- Support tickets -------------------------------------------------------
# Discord channel webhook that receives new support tickets
DISCORD_WEBHOOK_URL=

# --- Scholarship agreements: Dokobit e-signing -----------------------------
# Sandbox: https://id-sandbox.dokobit.com / https://gateway-sandbox.dokobit.com
DOKOBIT_IDENTITY_API_KEY=
DOKOBIT_IDENTITY_BASE_URL=https://id-sandbox.dokobit.com
DOKOBIT_DOCUMENTS_API_KEY=
DOKOBIT_DOCUMENTS_BASE_URL=https://gateway-sandbox.dokobit.com
DOKOBIT_DOCUMENTS_UI_BASE_URL=
# Comma-separated IPs/hosts allowed to call /api/webhooks/dokobit
DOKOBIT_POSTBACK_ALLOWLIST=
# Set to 1 to stub identity verification locally
DOKOBIT_IDENTITY_MOCK=
# Set to 1 to show the Dokobit demo panel on agreement pages
NEXT_PUBLIC_DOKOBIT_DEMO_PANEL=

# School-side signer for scholarship agreements (board member)
SCHOOL_SIGNER_NAME=
SCHOOL_SIGNER_SURNAME=
SCHOOL_SIGNER_PERSONAL_CODE=
SCHOOL_SIGNER_COUNTRY_CODE=LV
# School-side signer for equipment agreements (laptop / keycard)
EQUIPMENT_SIGNER_NAME=
EQUIPMENT_SIGNER_SURNAME=
EQUIPMENT_SIGNER_PERSONAL_CODE=
EQUIPMENT_SIGNER_COUNTRY_CODE=LV

# n8n webhooks that email the signed agreement to the student
N8N_SCHOLARSHIP_COMPLETED_URL=
N8N_EQUIPMENT_COMPLETED_URL=
# HMAC-SHA256 secret for the X-StartSchool-Signature header
N8N_SCHOLARSHIP_SHARED_SECRET=

# --- PDF rendering (agreements, diplomas) ----------------------------------
# Local only: path to a Chrome/Chromium binary for puppeteer-core.
# On Vercel @sparticuz/chromium is used automatically.
PUPPETEER_LOCAL_CHROME_PATH=
