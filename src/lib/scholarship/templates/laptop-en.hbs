        margin-top: 0.4cm;
        page-break-inside: avoid;
      }
      .signatures .sig-row {
        display: flex;
        align-items: flex-end;
        margin-bottom: 0.8cm;
      }
      .signatures .sig-label {
        width: 6cm;
        font-weight: 700;
        font-family: "Noto Sans", "DejaVu Sans", sans-serif;
      }
      .signatures .sig-line {
        flex: 1;
        border-bottom: 1px solid #000;
        min-height: 1.5em;
      }
      .signatures .sig-name {
        flex: 1;
      }
      .on-behalf {
        font-style: italic;
      }
      .return-act {
        page-break-before: always;
      }
