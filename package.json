    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@uiw/react-md-editor": "^4.1.5",
    "@vercel/analytics": "^1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "d3-dsv": "^3.0.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.43.0",
    "handlebars": "^4.7.10",
    "jszip": "^3.10.2",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.13.0",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "node-html-parser": "^9.0.5",
    "onborda": "^1.2.5",
    "openai": "^7.43.0",
    "posthog-js": "^1.438.22",
    "posthog-node": "^5.57.2",
    "puppeteer-core": "^25.16.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/d3-dsv": "^3.0.7",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
