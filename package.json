{
  "name": "startschool-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && npm run seam-audit",
    "seam-audit": "node scripts/seam-audit.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rewards": "vitest run tests/rewards",
    "ai-review:calibrate": "npx tsx scripts/ai-review-calibrate.ts",
    "ai-review:replay": "npx tsx scripts/ai-review-replay.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "analyze": "next experimental-analyze",
    "prepare": "husky"
  },
  "dependencies": {
